{
  "name": "nhncanal-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run build",
    "dev": "astro dev --host 127.0.0.1",
    "start": "npm run dev",
    "check": "astro check",
    "build": "astro build",
    "build:github": "node scripts/github-pages.mjs build",
    "preview:github": "node scripts/github-pages.mjs preview --host 127.0.0.1 --port 4322",
    "test:github": "node scripts/github-pages.mjs test",
    "search:refresh": "python3 scripts/refresh-documents.py",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test scripts/paths.test.mjs && npm run check && npm run build && node scripts/verify-build.mjs && node scripts/verify-search.mjs",
    "serve": "npm run preview",
    "deploy": "npm run build && wrangler pages deploy ./dist",
    "preview:pages": "wrangler pages dev ./dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "pagefind": "^1.5.2",
    "parse5": "^8.0.1",
    "typescript": "^5.9.0"
  }
}
