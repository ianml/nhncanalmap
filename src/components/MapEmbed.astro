---
interface Props { src?: string; title?: string }
const {
  src = '/beta/map/index.html',
  title = 'New Haven and Northampton Canal Lidar map beta',
} = Astro.props;
---
  <section class="map-embed" aria-label="Embedded Lidar map" data-active="false">
    <div class="map-interaction-bar">
      <p class="muted" id="map-interaction-status" aria-live="polite">Activate the map to zoom, pan, and use its controls.</p>
      <button class="button-link" id="map-deactivate" type="button" hidden>Done exploring</button>
    </div>
    <div class="map-frame">
      <iframe id="beta-map" src={src} title={title} loading="eager" tabindex="-1" inert allowfullscreen></iframe>
      <button class="map-activate" type="button" aria-controls="beta-map" aria-describedby="map-interaction-status">
        <span>Click to interact with map<small>Scroll past freely · Click or tap to explore</small></span>
      </button>
    </div>
    <noscript><p>To interact with the map, <a href={src}>open the full screen map</a>.</p></noscript>
  </section>
  <script>
    const embed = document.querySelector<HTMLElement>('.map-embed');
    const frame = document.querySelector<HTMLIFrameElement>('#beta-map');
    const activate = document.querySelector<HTMLButtonElement>('.map-activate');
    const deactivate = document.querySelector<HTMLButtonElement>('#map-deactivate');
    const status = document.querySelector<HTMLElement>('#map-interaction-status');

    if (embed && frame && activate && deactivate && status) {
      const setActive = (active: boolean, returnFocus = false) => {
        embed.dataset.active = String(active);
        frame.inert = !active;
        frame.tabIndex = active ? 0 : -1;
        activate.hidden = active;
        deactivate.hidden = !active;
        status.textContent = active
          ? 'Map active. Press Escape or choose Done exploring to scroll the page again.'
          : 'Activate the map to zoom, pan, and use its controls.';
        if (active) frame.focus({ preventScroll: true });
        else if (returnFocus) activate.focus({ preventScroll: true });
      };

      activate.addEventListener('click', () => setActive(true));
      deactivate.addEventListener('click', () => setActive(false, true));
      document.addEventListener('pointerdown', (event) => {
        if (event.target instanceof Node && !embed.contains(event.target) && embed.dataset.active === 'true') {
          setActive(false);
        }
      });
      document.addEventListener('focusin', (event) => {
        if (event.target instanceof Node && !embed.contains(event.target) && embed.dataset.active === 'true') {
          setActive(false);
        }
      });
      const onEscape = (event: KeyboardEvent) => {
        if (event.key === 'Escape' && embed.dataset.active === 'true') {
          event.preventDefault();
          event.stopImmediatePropagation();
          setActive(false, true);
        }
      };
      document.addEventListener('keydown', onEscape, true);
      // Keyboard events inside the same-origin iframe don't bubble to the page.
      const bindFrameKeys = () => frame.contentDocument?.addEventListener('keydown', onEscape, true);
      frame.addEventListener('load', bindFrameKeys);
      bindFrameKeys();
    }
  </script>
<style>
  .map-interaction-bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1rem; min-height: 3rem; }
  .map-interaction-bar p { margin: 0; flex: 1 1 240px; }
  .map-interaction-bar button { color: var(--accent); font-size: .9rem; }
  .map-interaction-bar button[hidden] { display: none; }
  .map-embed .map-frame { position: relative; margin-top: .5rem; }
  .map-embed[data-active='false'] iframe { pointer-events: none; }
  .map-activate { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; padding: 1rem; border: 0; color: var(--text); background: rgb(0 0 0 / 8%); touch-action: pan-y pinch-zoom; }
  .map-activate[hidden] { display: none; }
  .map-activate > span { padding: .85rem 1.25rem; border: 1px solid var(--border); border-radius: 6px; background: var(--bg); box-shadow: 0 2px 12px rgb(0 0 0 / 15%); font-weight: 600; }
  .map-activate small { display: block; margin-top: .2rem; color: var(--muted); font-size: .8rem; font-weight: 400; }
  .map-activate:focus-visible { outline-offset: -4px; }
  .map-activate:hover > span { border-color: var(--accent); }
</style>
